# Supabase (from Lovable: View Backend → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
# Server-only admin client (Supabase → Project Settings → API → service_role). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Delivery distance (Google Cloud → enable Distance Matrix API → create key)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Your real kitchen address (used as the delivery origin)
VITE_KITCHEN_ORIGIN=123 Example St, Fort Lauderdale, FL 33301

# Future Stripe payments (leave unset until you wire checkout)
# STRIPE_SECRET_KEY=sk_live_xxx

# Server-only admin allowlist (comma-separated). No VITE_ prefix = never shipped to the browser.
# Must match the public.admin_emails table seeded in the RLS migration.
ADMIN_EMAILS=admin@example.com,owner@example.com

# Google Sheet order sync (server-only). Apps Script Web App bound to the live
# order spreadsheet — see docs/integrations/google-sheet-orders.md for setup.
# Orders still succeed if these are unset; rows just aren't synced.
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
SHEETS_WEBAPP_SECRET=generate-a-long-random-string
